{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "jsdoc", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "options": {
    "typeAware": true,
    "maxWarnings": 0,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "fixtures/**", ".runs/**", "**/*.md"],
  "rules": {
    "no-console": ["error", { "allow": ["warn", "error", "info"] }],
    "react/react-in-jsx-scope": "off",
    // Side-effect imports (CSS) are intentional and carry no binding.
    "import/no-unassigned-import": "off"
  },
  "overrides": [
    {
      "files": ["**/src/**/*.{ts,tsx}"],
      "rules": {
        "max-lines": ["error", { "max": 200, "skipBlankLines": true, "skipComments": true }]
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "**/test/**", "**/*.live.ts"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["apps/viewer/**"],
      "env": {
        "browser": true
      }
    }
  ]
}
