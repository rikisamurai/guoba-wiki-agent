{
  "name": "guoba-wiki-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "simple-git-hooks": "^2.14.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm lint"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,yml,yaml,css,md,html}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.10"
}
